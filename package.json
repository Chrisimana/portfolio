{
  "name": "portofolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",

    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",

    "validate": "node scripts/validate.ts && node scripts/images-check.ts",
    "images:check": "node scripts/images-check.ts",
    "tech:icons": "node scripts/generate-tech-icons.ts",

    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --project unit --project nuxt",
    "pretest:e2e": "node scripts/clean-content-cache.ts",
    "test:e2e": "vitest run --project e2e",
    "posttest:e2e": "node scripts/clean-content-cache.ts",
    "test:watch": "vitest --project unit --project nuxt",

    "prebuild": "npm run validate",
    "pregenerate": "npm run validate",
    "postgenerate": "node scripts/strip-content-dumps.ts && node scripts/apply-preview-headers.ts"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.0",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/test-utils": "^4.2.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.11.0",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "gray-matter": "^4.0.3",
    "h3": "^1.15.11",
    "happy-dom": "^20.14.0",
    "image-meta": "^0.2.2",
    "nuxt": "^4.5.2",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
